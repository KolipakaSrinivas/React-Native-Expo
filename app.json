{
  "expo": {
    "name": "NotesApp",
    "slug": "NotesApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Notes-App-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Notes-App-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.srinivask.gamenative"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Notes-App-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Notes-app-splash.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bdb9282b-585f-44fa-b09e-fb6260d1f1ed"
      }
    }
  }
}
